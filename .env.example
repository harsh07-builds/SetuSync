# Copy to .env and fill in.  docker compose reads it automatically.

# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Generate with:  node scripts/generate-signing-key.mjs
SETUSYNC_SIGNING_KID=relay-1
SETUSYNC_SIGNING_PRIVATE_KEY_PKCS8_B64=
SETUSYNC_SIGNING_PUBLIC_KEY_SPKI_B64=

# Change before exposing the database anywhere.
POSTGRES_PASSWORD=setusync

# Free SerpApi plan = 250 searches/month. Raise on a paid plan.
SETUSYNC_GOVERNOR_MONTHLY_CREDIT_BUDGET=240
SETUSYNC_GOVERNOR_PER_INSTALL_CREDIT_QUOTA=40
SETUSYNC_GOVERNOR_GLOBAL_KILL_SWITCH=false

# Public port of the web container (app + relay proxy).
WEB_PORT=8088

# Leave empty: the browser calls the relay through the web container.
# Only set when the relay is on another domain (then also set CORS below).
RELAY_URL=
SETUSYNC_CORS_ALLOWED_ORIGINS=http://localhost:8088
